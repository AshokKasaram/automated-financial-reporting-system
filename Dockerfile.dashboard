FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir streamlit==1.35.0 plotly==5.22.0 pandas==2.2.2 pyarrow==16.0.0 \
    "sqlalchemy>=1.4.36,<2.0" pymysql==1.1.0 cryptography faker==25.0.0

COPY . .

EXPOSE 8501

CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0", "--server.headless=true"]
